#
# Note: BusyBox init doesn't support runlevels.  The runlevels field is
# completely ignored by BusyBox init. If you want runlevels, use
# sysvinit.
#
# Format for each entry: <id>:<runlevels>:<action>:<process>
#
# id        == tty to run on, or empty for /dev/console
# runlevels == ignored
# action    == one of sysinit, respawn, askfirst, wait, and once
# process   == program to run
#
# ---------------------------------------------------------------------------
# This file is an ORCHESTRATOR OVERLAY of Buildroot's skeleton inittab; the
# tty1 getty (the HDMI console) exists only here. If you bump Buildroot, diff its
# skeleton against this file — the overlay is copied at the very end of
# target-finalize and therefore overwrites anything the skeleton's own getty and
# remount-rootfs hooks wrote, which also makes BR2_TARGET_GENERIC_GETTY_PORT and
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW dead config. The remount line below is
# what the latter would have added; do not drop it.
# ---------------------------------------------------------------------------

# Startup the system
::sysinit:/bin/mount -t proc proc /proc
::sysinit:/bin/mount -o remount,rw /
::sysinit:/bin/mkdir -p /dev/pts /dev/shm
::sysinit:/bin/mount -a
::sysinit:/bin/mkdir -p /run/lock/subsys
::sysinit:/sbin/swapon -a
null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
::sysinit:/bin/hostname -F /etc/hostname
# now run any rc scripts. BusyBox init runs every sysinit action to completion
# BEFORE it starts any respawn entry, so nothing here may block: S99agent
# therefore backgrounds its own body, or there would be no login prompt on any
# console until the network work finished.
::sysinit:/etc/init.d/rcS

# Serial and HDMI consoles, both named EXPLICITLY.
#
# The obvious spelling for the first one is `console::respawn:`, which is what
# the skeleton ships. It is a trap: /dev/console resolves to the LAST console=
# in cmdline.txt, so on a board where ttyAMA0 does not register — a Pi 5
# without uart0 enabled, for instance — it silently becomes tty1, and then BOTH
# entries spawn a getty on tty1. The two fight over the same terminal and the
# keyboard reads as dead.
# Only tty1 is declared here. The UART getty is added at runtime by
# S00console, and ONLY when /dev/ttyAMA0 actually exists.
#
# Declaring it unconditionally is wrong: a board with
# no ttyAMA0 respawns the getty forever, printing "can't open /dev/ttyAMA0" a
# few times a second and burying every other message on the screen. BusyBox
# init has no conditional entries, so the condition has to live outside.
tty1::respawn:/sbin/getty -L tty1 0 linux            # HDMI console

# Stuff to do for the 3-finger salute
#::ctrlaltdel:/sbin/reboot

# Stuff to do before rebooting
::shutdown:/etc/init.d/rcK
::shutdown:/sbin/swapoff -a
::shutdown:/bin/umount -a -r
