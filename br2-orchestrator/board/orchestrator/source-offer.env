# Facts the written source offer in the image names. ONE place, on purpose:
# notices/make-notices.sh reads it for the build, scripts/inject-notices.sh for
# a rebake, scripts/check-notices.sh to assert that an image names the base it
# was built from. Update it per clean rebuild, never per agent rebake: a
# rebake swaps only the agent and leaves the GPL corpus — and therefore the
# base — unchanged. scripts/make-source-bundle.sh --write-env writes the base
# id and the bundle's sha256; the toolchain fields below are edited by hand
# (br2-orchestrator/README.md, "The toolchain source snapshot").
#
# Shell syntax, sourced by POSIX sh. Values are single-quoted; no expansions.

# Identity of the GPL corpus: Buildroot release, the commit of this repository
# the build consumed (the build commit), and the build date (YYYYMMDD). The bundle is named after it:
# recovery-image-source-<base id>.tar
SOURCE_BASE_ID='buildroot-2026.02.3+br2-1cd5ae3e+20261119'

# sha256 of the corresponding-source bundle for that base, as served.
SOURCE_BUNDLE_SHA256='d608d315764181e289864e0861015c4c859fbf7201e6b88cd3b69ba7bbd3c5e0'

# Earliest base whose source can be supplied. A constant, not a per-rebuild
# value: images built before this date predate the external tree and cannot be
# reconstructed, and the offer says so.
SOURCE_FIRST_BASE_DATE='2026-07-28'

# Where a request may also be sent when the install's own URL is not
# reachable (a card provisioned from an install that has since gone away).
# The written offer is made by whoever builds and distributes the image: a
# builder who distributes their own base puts their own name and address here
# before building it.
SOURCE_OFFER_CONTACT='Uptime Lab Inc., https://orchestrator.sh'

# The target C library, libgcc and libstdc++ come from the prebuilt Arm GNU
# Toolchain, whose source Buildroot does not save; Arm's source snapshot is
# served beside the bundle under this name.
SOURCE_TOOLCHAIN_FILE='arm-gnu-toolchain-src-snapshot-14.2.rel1.tar.xz'
SOURCE_TOOLCHAIN_SHA256='e6405f20f8a817a50d92dbf7974d0ee77708dfdf9e79900a59c5d343b464ef9c'
